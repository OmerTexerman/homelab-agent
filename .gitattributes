# git autocrlf=true converts LF to CRLF on Windows, causing issues with oxfmt
* text=auto eol=lf
# Batch files need CRLF for cmd.exe to parse them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf

# Upstream reference repos and binary/vendor header bundles are mirrored as-is.
.repos/** -whitespace
apps/mobile/modules/t3-terminal/Vendor/** -whitespace
