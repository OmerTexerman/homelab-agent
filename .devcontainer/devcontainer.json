{
  "name": "T3 Code Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "vscode",
  "containerEnv": {
    "HOST": "0.0.0.0",
    "T3CODE_HOST": "0.0.0.0",
    "T3CODE_HOME": "${localWorkspaceFolder}/.devcontainer/state/t3code",
    "T3CODE_NO_BROWSER": "1",
    "HOMELAB_AGENT_RUNTIME_CONTEXT": "${localWorkspaceFolder}/docker/runtime",
    "HOMELAB_AGENT_RUNTIME_DOCKERFILE": "${localWorkspaceFolder}/docker/runtime/Dockerfile"
  },
  "mounts": [
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "appPort": [5733, 13773],
  "forwardPorts": [5733, 13773],
  "portsAttributes": {
    "5733": {
      "label": "Homelab Agent Web"
    },
    "13773": {
      "label": "Homelab Agent Server"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.3.11"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.13.1"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.10",
      "installTools": false
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/git",
    "ghcr.io/devcontainers-extra/features/bun"
  ],
  "postCreateCommand": "npm install --global @openai/codex@0.130.0 @anthropic-ai/claude-code@2.1.143 opencode-ai@1.15.1 && bun install --backend=copyfile --frozen-lockfile --force",
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode"]
    }
  }
}
