# Homelab Agent host alerts. Install as /etc/homelab-agent/notify.env (mode 0600).
# Without this file (or with NTFY_URL empty) alerts are disabled.
# KEY=VALUE lines only; the file is parsed, not sourced.

# Full topic URL: https://ntfy.sh/<hard-to-guess-topic> or a self-hosted server.
NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic

# Optional access token for a protected topic (sent as "Authorization: Bearer").
NTFY_TOKEN=

# How often a still-raised alert is repeated, in hours (0 = only once).
NOTIFY_REPEAT_HOURS=12

# homelab-agent-health thresholds (all optional; defaults shown).
#HEALTH_DISK_WARN_PERCENT=85
#HEALTH_DISK_URGENT_PERCENT=95
#HEALTH_BACKUP_MAX_AGE_DAYS=8
#HEALTH_TLS_HOST=ai.texerman.com
#HEALTH_TLS_PORT=443
#HEALTH_TLS_MIN_DAYS=14
#HEALTH_PUBLIC_URL=https://ai.texerman.com/api/auth/session
#HEALTH_DEPLOY_FAILURES=3
#HEALTH_DOCKER_MAX_GB=20
#HEALTH_DOCKER_MAX_DANGLING=10
